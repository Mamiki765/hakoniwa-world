APP_NAME="箱庭諸島２S＋"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8080

HAKONIWA_WEB_PORT=8080

HAKONIWA_POSTGRES_DB=hakoniwa
HAKONIWA_POSTGRES_USER=hakoniwa
HAKONIWA_POSTGRES_PASSWORD=

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://127.0.0.1:8080/auth/discord/callback

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8080/auth/google/callback

# Public report and appeal contact. Set an operator-owned external form or page.
HAKONIWA_MODERATION_CONTACT_URL=
HAKONIWA_ADMIN_DISCORD_USER_ID=

# Standard tile asset configuration.
HAKONIWA_TILE_ASSET_BASE_URL=/assets/hakoniwa-tiles
HAKONIWA_TILE_ASSET_PATH=/srv/hakoniwa-assets/tiles

# Deprecated compatibility variables. Leave blank unless upgrading an existing deployment.
HAKONIWA_ORIGINAL_ASSET_BASE_URL=
HAKONIWA_ORIGINAL_ASSET_PATH=

SESSION_SECURE_COOKIE=false
TZ=Asia/Tokyo
